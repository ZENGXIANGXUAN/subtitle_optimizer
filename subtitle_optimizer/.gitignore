*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# 运行时产物
# 自 2026-07-26 起 utils.log_root() 默认写到 ~/.subtitle_optimizer/logs，
# 不再污染源码目录。这里保留 logs/ 是为了忽略历史遗留目录。
logs/
*.log

# Claude Code 的临时 worktree。必须忽略：里面是整个仓库的副本，
# 被 pytest 收集会造成同名测试模块冲突，整个测试套件在收集阶段报错。
.claude/worktrees/

# 编辑器备份与打包快照
*.bak
*.bak*
*.zip
_backups/

# 流水线测试运行产物（2026-10-15 起不再入库；历史 _artifacts_2026* 已从 git 移除）
_artifacts_*/

# 任务作业数据（只留在本地，不进 GitHub）
job_trading_course/

# 本地配置与密钥
.env
.idea/
